# Django core
SECRET_KEY=
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend URL (用於 email 中的連結，例如 password reset、email verification)
FRONTEND_URL=http://localhost:5173

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Auth
LOGIN_THROTTLE_RATE=5/min

# Cache / Channels
REDIS_HOST=redis

# Database
DB_NAME=django_channel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# GEMINI_API_KEY 留空時後端走 stub 假串流模式，整套流程還是可運作
# 申請 token 後填入即自動切換 Gemini，無需改 code。
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
